{
    "name": "wpmudev/cleanup-report-generator",
    "description": "WordPress Cleanup Report Generator with PDF export",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "dompdf/dompdf": "^3.1"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "CleanupReportGenerator\\Vendor\\",
            "classmap_prefix": "Cleanup_Report_Vendor_",
            "constant_prefix": "CLEANUP_REPORT_VENDOR_",
            "packages": [
                "dompdf/dompdf"
            ],
            "delete_vendor_packages": true,
            "update_call_sites": false
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "@composer --working-dir=tools/strauss install --no-interaction --quiet",
            "@php tools/strauss/run.php",
            "@php tools/strauss/patch.php",
            "@composer dump-autoload --optimize"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
